# ========================================
# BACKEND - Variables de Entorno
# ========================================
# Copia este archivo como .env y completa los valores

# ========================================
# Base de datos PostgreSQL (Neon)
# ========================================
# URL de conexión a la base de datos PostgreSQL.
# Ejemplo (Neon): postgresql://neondb_owner:TU_PASSWORD@ep-XXXXX.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/nombre_bd?sslmode=require

# ========================================
# JWT (JSON Web Token)
# ========================================
# Clave secreta para firmar los tokens JWT. Usa una cadena larga y aleatoria.
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=tu-clave-secreta-segura-aqui
# Tiempo de expiración del token en segundos (86400 = 24 horas)
JWT_EXPIRES_IN=86400

# ========================================
# Servidor
# ========================================
# Puerto donde correrá el servidor backend
PORT=3001
# Entorno: development | production | test
NODE_ENV=development

# ========================================
# CORS - URL del frontend (Vercel)
# ========================================
# URL del frontend para permitir solicitudes CORS.
# Ejemplo: https://tu-app.vercel.app
FRONTEND_URL=https://tu-app.vercel.app

# ========================================
# (Opcional) Configuración adicional
# ========================================
# Nivel de logging: debug, verbose, log, warn, error
# LOG_LEVEL=log
# Límite de cuerpo de peticiones en MB (por defecto 10mb)
# MAX_BODY_SIZE=10mb
